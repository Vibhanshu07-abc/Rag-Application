# Copy to .env for local development. Values marked REQUIRED must be supplied.
APP_NAME=Production RAG API
APP_ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Text processing
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# MySQL — REQUIRED. Must match .env.docker for the provided Compose service.
DATABASE_URL=mysql+asyncmy://rag_user:replace-with-mysql-password@127.0.0.1:3306/rag_app

# Redis — required when RATE_LIMIT_ENABLED=true and for the document worker.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Authentication — REQUIRED. Generate a long random value for every non-local deployment.
AUTH_JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=rag-app
AUTH_JWT_AUDIENCE=rag-app-api
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# Chroma
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_DATABASE_NAME=rag_app
RETRIEVAL_TOP_K=4

# LLM — REQUIRED only for /rag/query generation.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_LLM_MODEL=gemini-2.5-flash

# Browser/API security
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
SECURITY_FORCE_HTTPS=false
SECURITY_ENABLE_HSTS=false

# Redis rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_KEY_PREFIX=rag-api
RATE_LIMIT_GENERAL_REQUESTS=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_RAG_REQUESTS=60
RATE_LIMIT_RAG_WINDOW_SECONDS=60

# Document worker
DOCUMENT_WORKER_CONCURRENCY=1
DOCUMENT_WORKER_POLL_SECONDS=5
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_RETRY_BASE_SECONDS=10
DOCUMENT_JOB_PROCESSING_TIMEOUT_SECONDS=3600
